    <string name="pref_cc_swap_sliders_desc">Swaps them to brightness on the left and volume on the right, and syncs their heights.</string>
    <string name="pref_cc_ios_connectivity_title">iOS 15 style 2×2 connectivity card</string>
    <string name="pref_cc_ios_connectivity_desc">A 2×2 grid of Wi-Fi, data, Bluetooth and airplane mode.</string>

