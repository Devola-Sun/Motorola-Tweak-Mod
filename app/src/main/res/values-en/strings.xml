    <!-- Appearance -->
    <string name="section_appearance">Icons and labels</string>
    <string name="hide_labels_title">Hide icon labels</string>
    <string name="hide_labels_summary">Makes labels transparent in Workspace, All Apps, folders and the Dock.</string>

    <string name="icon_shape_title">Icon shape</string>
    <string name="icon_shape_summary">Choose SYSTEM to restore the standard mask. Clearing the icon cache is recommended after changing the shape.</string>

    <string name="folder_preview_3x3_title">3×3 folder icon preview</string>
    <string name="folder_preview_3x3_summary">Shows up to 9 app icons in a 3×3 preview. The opened folder uses a fixed 4×4 grid (max 16) aligned from the top-left.</string>

    <string name="section_layout">Home screen grid</string>
    <string name="layout_summary">Rows, columns and Dock icons range from 4 to 10. Restart the launcher after changing.</string>
    <string name="grid_rows_title">Desktop rows</string>
    <string name="grid_columns_title">Desktop columns</string>
    <string name="dock_icons_title">Dock icons</string>

    <!-- SystemUI -->
    <string name="section_systemui_title">Status bar</string>
    <string name="section_control_center_title">Control center</string>
    <string name="systemui_hint">Status bar settings are applied after restarting SystemUI.</string>

    <string name="pref_sb_show_seconds_title">Show clock seconds</string>
    <string name="pref_sb_show_seconds_desc">Shows seconds (hh:mm:ss) in the status bar clock.</string>
    <string name="pref_sb_hide_battery_percent_title">Hide battery percentage</string>
    <string name="pref_sb_hide_battery_percent_desc">Hides the percentage and shows only the battery icon.</string>
    <string name="pref_sb_hide_volte_title">Hide VoLTE / VoWiFi / NFC icons</string>
    <string name="pref_sb_hide_volte_desc">Hides VoLTE, HD voice, VoWiFi, NFC and dual-SIM indicators.</string>
    <string name="pref_sb_ios_icons_title">iOS-style icons (Wi-Fi / signal)</string>
    <string name="pref_sb_ios_icons_desc">Replaces Wi-Fi with a fan shape and signal with 4-bar iOS style.</string>
    <string name="pref_sb_custom_padding_title">Apply razr fold optimized padding</string>
    <string name="pref_sb_custom_padding_desc">Adjusts the margins of the main (punch-hole) and cover displays.</string>

    <!-- Battery -->
    <string name="section_battery_title">Battery</string>
    <string name="battery_hint">Status bar changes apply after restarting SystemUI; charging control applies after a device reboot.</string>
    <string name="battery_icon_style_title">Battery icon</string>
    <string name="battery_icon_style_summary">Changes the status bar battery icon shape.</string>
    <string name="battery_icon_style_system">System default</string>
    <string name="battery_icon_style_circle">Circle</string>
    <string name="battery_icon_style_pill">Pill</string>
    <string name="battery_icon_style_hidden">Hidden</string>
    <string name="battery_percent_style_title">Battery percentage</string>
    <string name="battery_percent_style_summary">Switch between always visible, hidden and inside the icon. "Inside icon" is drawn as a pill.</string>
    <string name="battery_percent_style_system">System default</string>
    <string name="battery_percent_style_always">Always visible</string>
    <string name="battery_percent_style_hidden">Hidden</string>
    <string name="battery_percent_style_in_icon">Inside the icon</string>
    <string name="battery_charge_limit_title">Enable charging stop at 80%</string>
    <string name="battery_charge_limit_desc">Uses Motorola adaptive charging to stop charging at the selected level.</string>
    <string name="battery_charge_limit_value_title">Charge stop threshold</string>
    <string name="battery_charge_limit_value_desc">Select 60–100%. Not applied on devices without Motorola charging control.</string>
    <string name="battery_charge_limit_value_format">%1$d%%</string>
    <string name="battery_disable_overheat_title">Remove battery temperature control</string>
    <string name="battery_disable_overheat_desc">Disables the battery over-temperature shutdown. Use at your own risk.</string>
    <string name="battery_reboot_hint">Charging and temperature control live in system_server; reboot the device after changing them.</string>

    <string name="section_screenshot_title">Screenshots</string>
    <string name="disable_flag_secure_title">Disable FLAG_SECURE (allow screenshots)</string>
    <string name="disable_flag_secure_desc">Ignores FLAG_SECURE so protected screens can be captured and recorded.</string>
    <string name="disable_flag_secure_warning">Security-protected screens (banking apps etc.) become capturable. Enable only when needed.</string>

