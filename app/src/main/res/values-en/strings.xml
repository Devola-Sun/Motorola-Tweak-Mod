    <string name="pref_corepatch_bypass_digest_desc">Installs while ignoring digest verification errors</string>
    <string name="corepatch_reboot_note">※ A device reboot or soft reboot (Zygote restart) is required to apply system framework changes.</string>
    <string name="pref_safe_mode_title">Safe mode (unsupported device protection)</string>
    <string name="pref_safe_mode_desc">Avoids crashes and boot loops when flags are enabled on devices other than the razr fold. Error logs are force-written to /sdcard/Download/Errorlog.</string>
