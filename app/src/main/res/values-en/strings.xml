    <string name="xposed_description">MockingBatwing — Motorola Razr launcher + SystemUI + System Framework customization (LSPosed): icons, grid, labels, status bar, control center, CorePatch, and launcher layout backup/restore.</string>

    <string name="settings_title">MockingBatwing</string>
    <string name="settings_subtitle">Manage launcher and SystemUI settings in one screen. Settings are saved to shared preferences.</string>
    <string name="settings_activation_hint">Enable the module in LSPosed and add com.motorola.launcher3, com.android.systemui and android to the scope. A device reboot is required the first time.</string>

