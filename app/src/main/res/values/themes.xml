<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MotoLauncherMod" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryDark">@color/app_background</item>
        <item name="colorAccent">@color/brand_blue</item>
        <!-- Material Slider tooltips need Material color roles even though the
             rest of the app uses an AppCompat theme. -->
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="colorOnBackground">@color/app_text</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text</item>
        <item name="colorError">@color/danger</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="popupMenuStyle">@style/Widget.Moto.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Moto.PopupMenu</item>
    </style>

    <style name="Widget.Moto.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <style name="Widget.Moto.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:minWidth">52dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:thumbTint">@color/switch_thumb_tint</item>
        <item name="android:trackTint">@color/switch_track_tint</item>
    </style>

    <style name="TextAppearance.Moto.Section" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.Moto.RowTitle" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Moto.RowSummary" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Moto.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Moto.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
