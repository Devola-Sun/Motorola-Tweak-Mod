    <!-- Cover-screen Dock -->
    <string name="section_cover_dock">外屏 Dock</string>
    <string name="cover_dock_enable_title">在外屏显示 Dock</string>
    <string name="cover_dock_enable_summary">在外屏显示底部快捷栏。</string>
    <string name="cover_dock_floating_island_title">悬浮岛 Dock</string>
    <string name="cover_dock_floating_island_summary">仅适用于外屏。为背景添加至少 20dp 的左右边距和 28dp 圆角。沿用背景宽度和高度设置，不改变图标数量或布局区域。</string>
    <string name="cover_dock_frost_title">磨砂玻璃 Dock</string>
    <string name="cover_dock_liquid_glass_title">液态玻璃 Dock</string>
    <string name="cover_dock_liquid_glass_summary">为外屏 Dock 添加半透明渐变和边缘反光。不能与磨砂玻璃同时启用。</string>
    <string name="section_main_dock">内屏 Dock</string>
    <string name="main_dock_frost_title">磨砂玻璃 Dock</string>
    <string name="main_dock_liquid_glass_title">液态玻璃 Dock</string>
    <string name="main_dock_glass_summary">启用任一样式后，原生 Dock 背景将变为透明，并在相同位置显示同等大小的玻璃效果。两种样式不能同时启用。全部关闭可恢复原生背景。不会对壁纸进行实际模糊处理。</string>
    <string name="folder_liquid_glass_title">液态玻璃文件夹</string>
    <string name="folder_liquid_glass_summary">为文件夹图标添加玻璃效果，并为展开的文件夹添加与通知中心、控制中心材质一致的容器。背景模糊跟随共用滑块。</string>
    <string name="cover_dock_frost_summary">通过半透明渐变和细微边框，为外屏 Dock 添加磨砂玻璃效果。不会模糊壁纸或图标。</string>
    <string name="cover_dock_height_title">Dock 背景高度</string>
    <string name="cover_dock_width_title">Dock 背景宽度</string>
    <string name="cover_dock_size_title">Dock 大小</string>
