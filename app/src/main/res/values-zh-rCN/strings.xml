    <string name="dock_icons_title">Dock 图标数量</string>

    <!-- SystemUI -->
    <string name="section_systemui_title">状态栏</string>
    <string name="section_control_center_title">控制中心</string>
    <string name="pref_cc_compact_layout_title">将媒体卡片移至顶部</string>
    <string name="pref_cc_compact_layout_desc">在连接卡片右侧放置正方形媒体卡片，下方排列亮度（左）和音量（右）滑块。左下区域上排为手电筒和自动旋转，下排为占两格宽的就寝模式按钮。</string>
    <string name="pref_cc_compact_layout_hint">需要 LSPosed 的 SystemUI 作用域。适用于竖屏和桌面模式。连接卡片的 2×2 布局可在 SystemUI 设置中配置。</string>
    <string name="systemui_hint">状态栏设置在重启 SystemUI 后生效。</string>

    <string name="pref_sb_show_seconds_title">显示时钟秒数</string>
    <string name="pref_sb_show_seconds_desc">在状态栏时钟中显示秒数（hh:mm:ss）。</string>
    <string name="pref_sb_hide_battery_percent_title">隐藏电池百分比</string>
    <string name="pref_sb_hide_battery_percent_desc">隐藏电量百分比，仅显示电池图标。</string>
    <string name="pref_sb_hide_volte_title">隐藏 VoLTE / VoWiFi / NFC 图标</string>
    <string name="pref_sb_hide_volte_desc">隐藏 VoLTE、高清通话、VoWiFi、NFC 和双 SIM 卡指示图标。</string>
    <string name="pref_sb_ios_icons_title">iOS 风格图标（Wi-Fi / 信号）</string>
    <string name="pref_sb_ios_icons_desc">将 Wi-Fi 图标替换为扇形，将信号图标替换为 iOS 风格的四格信号条。</string>
    <string name="pref_sb_custom_padding_title">应用 razr fold 优化边距</string>
    <string name="pref_sb_custom_padding_desc">调整内屏（挖孔屏）和外屏的边距。</string>

